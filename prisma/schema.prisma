generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// @deprecated Use audit_log model instead for unified tracking
model activitylog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], map: "ActivityLog_userId_fkey")

  @@index([userId], map: "ActivityLog_userId_idx")
}

/// @deprecated Use audit_log model instead for unified tracking
model auditlog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      user?    @relation(fields: [userId], references: [id], map: "AuditLog_userId_fkey")

  @@index([userId], map: "AuditLog_userId_idx")
}

model availability {
  id                String        @id @default(cuid())
  vendorProfileId   String
  date              DateTime
  isAvailable       Boolean       @default(true)
  startTime         String?
  endTime           String?
  bookingLimit      Int           @default(1)
  notes             String?
  peakPriceModifier Decimal?      @db.Decimal(5, 2)
  vendorprofile     vendorprofile @relation(fields: [vendorProfileId], references: [id], map: "Availability_vendorProfileId_fkey")

  @@index([vendorProfileId], map: "Availability_vendorProfileId_idx")
}

model booking {
  id                      String                    @id @default(cuid())
  bookingNumber           String                    @unique(map: "Booking_bookingNumber_key")
  vendorId                String?
  status                  booking_status            @default(PENDING)
  eventName               String?
  eventType               String?
  eventDescription        String?
  landmark                String?
  city                    String?
  state                   String?
  pincode                 String?
  commissionRate          Decimal                   @default(10.00) @db.Decimal(5, 2)
  commissionAmount        Decimal                   @default(0.00) @db.Decimal(10, 2)
  vendorPayout            Decimal                   @default(0.00) @db.Decimal(10, 2)
  taxAmount               Decimal                   @default(0.00) @db.Decimal(10, 2)
  discountAmount          Decimal                   @default(0.00) @db.Decimal(10, 2)
  subTotal                Decimal                   @default(0.00) @db.Decimal(10, 2)
  totalAmount             Decimal                   @db.Decimal(10, 2)
  couponId                String?
  eventDate               DateTime
  eventTime               String?
  eventLocation           String
  latitude                Float?
  longitude               Float?
  guestCount              Int
  specialInstructions     String?
  otp                     String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  checklist               Json?
  idempotencyKey          String?                   @unique
  vendorConfirmedAt5d     Boolean?
  advanceAmount           Decimal?                  @db.Decimal(10, 2)
  advancePaidAt           DateTime?
  balanceAmount           Decimal?                  @db.Decimal(10, 2)
  balanceDueDate          DateTime?
  balancePaidAt           DateTime?
  paymentStage            String?                   @default("PENDING")
  categoryId              String?
  eventTypeId             String?
  packageId               String?
  serviceTypeId           String?
  snapshot                Json?
  snapshotVersion         Int                       @default(1)
  subcategoryId           String?
  customerProfileId       String
  currentQuoteId          String?
  paymentDeadline         DateTime?
  viewedByVendor          Boolean                   @default(false)
  orderId                 String?
  audit_log               audit_log[]
  coupon                  coupon?                   @relation(fields: [couponId], references: [id], map: "Booking_couponId_fkey")
  customerprofile         customerprofile           @relation(fields: [customerProfileId], references: [id], map: "Booking_customerProfileId_fkey")
  vendorprofile           vendorprofile?            @relation(fields: [vendorId], references: [id], map: "Booking_vendorId_fkey")
  order                   order?                    @relation(fields: [orderId], references: [id])
  booking_addon           booking_addon[]
  booking_checklist       booking_checklist[]
  booking_document        booking_document[]
  booking_team_assignment booking_team_assignment[]
  booking_timeline        booking_timeline[]
  bookingassignment       bookingassignment[]
  bookingitem             bookingitem[]
  bookingstatuslog        bookingstatuslog[]
  cancellation_record     cancellation_record?
  conversation            conversation?
  counterquote            counterquote[]
  dispute                 dispute?
  eventcheckin            eventcheckin?
  invoice                 invoice?
  message                 message[]
  payment                 payment[]
  payment_split           payment_split[]
  refund                  refund?
  refund_request          refund_request[]
  review                  review?
  staff                   staff[]
  vendor_penalty          vendor_penalty[]

  @@index([couponId], map: "Booking_couponId_idx")
  @@index([customerProfileId], map: "Booking_customerProfileId_idx")
  @@index([vendorId], map: "Booking_vendorId_idx")
  @@index([customerProfileId, status, createdAt])
  @@index([status])
  @@index([eventDate])
  @@index([createdAt])
  @@index([eventTypeId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([serviceTypeId])
  @@index([packageId])
}

model bookingassignment {
  id            String                   @id @default(cuid())
  bookingId     String
  vendorId      String
  status        bookingassignment_status @default(PENDING)
  retryCount    Int                      @default(0)
  priority      Int
  notes         String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime
  booking       booking                  @relation(fields: [bookingId], references: [id], map: "BookingAssignment_bookingId_fkey")
  vendorprofile vendorprofile            @relation(fields: [vendorId], references: [id], map: "BookingAssignment_vendorId_fkey")

  @@unique([bookingId, vendorId], map: "BookingAssignment_bookingId_vendorId_key")
  @@index([vendorId, status])
  @@index([bookingId, status])
  @@index([vendorId], map: "BookingAssignment_vendorId_idx")
}

model bookingitem {
  id             String          @id @default(cuid())
  bookingId      String
  serviceId      String
  packageId      String?
  price          Decimal         @db.Decimal(10, 2)
  quantity       Int             @default(1)
  booking        booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade, map: "BookingItem_bookingId_fkey")
  Renamedpackage Renamedpackage? @relation(fields: [packageId], references: [id], map: "BookingItem_packageId_fkey")
  service        service         @relation(fields: [serviceId], references: [id], map: "BookingItem_serviceId_fkey")

  @@index([bookingId], map: "BookingItem_bookingId_idx")
  @@index([packageId], map: "BookingItem_packageId_idx")
  @@index([serviceId], map: "BookingItem_serviceId_idx")
}

model bookingstatuslog {
  id        String                  @id @default(cuid())
  bookingId String
  status    bookingstatuslog_status
  notes     String?
  createdAt DateTime                @default(now())
  booking   booking                 @relation(fields: [bookingId], references: [id], map: "BookingStatusLog_bookingId_fkey")

  @@index([bookingId], map: "BookingStatusLog_bookingId_idx")
}

model staff {
  id        String   @id @default(cuid())
  bookingId String
  name      String
  role      String
  phone     String?
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   booking  @relation(fields: [bookingId], references: [id], map: "Staff_bookingId_fkey")

  @@index([bookingId], map: "Staff_bookingId_idx")
}

model cart {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  customerProfileId String          @unique(map: "Cart_customerProfileId_key")
  customerprofile   customerprofile @relation(fields: [customerProfileId], references: [id], map: "Cart_customerProfileId_fkey")
  cartitem          cartitem[]
}

model cartitem {
  id            String    @id @default(cuid())
  cartId        String
  type          String
  targetId      String
  quantity      Int       @default(1)
  vendorId      String?
  packageId     String?
  eventDate     DateTime?
  eventTime     String?
  guestCount    Int?
  location      String?
  notes         String?
  addons        Json?
  packagePrice  Decimal?  @db.Decimal(10, 2)
  addonPrice    Decimal?  @db.Decimal(10, 2)
  gst           Decimal?  @db.Decimal(10, 2)
  platformFee   Decimal?  @db.Decimal(10, 2)
  discount      Decimal?  @db.Decimal(10, 2)
  totalPrice    Decimal?  @db.Decimal(10, 2)
  priceSnapshot Decimal?  @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cart          cart      @relation(fields: [cartId], references: [id], onDelete: Cascade, map: "CartItem_cartId_fkey")

  @@unique([cartId, targetId, type], map: "CartItem_cartId_targetId_type_key")
}

model eventtype {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  image       String?
  icon        String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categories  category[]

  @@index([isActive])
}

model category {
  id                 String               @id @default(cuid())
  name               String
  description        String?
  icon               String?
  commissionRate     Decimal?             @db.Decimal(5, 2)
  image              String?
  eventTypeId        String
  eventtype          eventtype            @relation(fields: [eventTypeId], references: [id])
  checklist_template checklist_template[]
  subcategory        subcategory[]
  vendorprofile      vendorprofile[]

  @@unique([name, eventTypeId])
  @@index([eventTypeId])
}

model conversation {
  id                      String                    @id @default(cuid())
  bookingId               String?                   @unique(map: "Conversation_bookingId_key")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  booking                 booking?                  @relation(fields: [bookingId], references: [id], map: "Conversation_bookingId_fkey")
  conversationparticipant conversationparticipant[]
  message                 message[]
}

model conversationparticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  conversation   conversation @relation(fields: [conversationId], references: [id], map: "ConversationParticipant_conversationId_fkey")
  user           user         @relation(fields: [userId], references: [id], map: "ConversationParticipant_userId_fkey")

  @@unique([conversationId, userId], map: "ConversationParticipant_conversationId_userId_key")
  @@index([userId], map: "ConversationParticipant_userId_idx")
}

model coupon {
  id                 String              @id @default(cuid())
  code               String              @unique(map: "Coupon_code_key")
  discountType       String
  discountValue      Decimal             @db.Decimal(10, 2)
  minBookingAmount   Decimal?            @db.Decimal(10, 2)
  expiryDate         DateTime
  isActive           Boolean             @default(true)
  campaignId         String?
  categoryRestrict   String?
  isFirstBooking     Boolean             @default(false)
  maxDiscount        Decimal?            @db.Decimal(10, 2)
  stackable          Boolean             @default(false)
  usageLimit         Int                 @default(1)
  usedCount          Int                 @default(0)
  vendorRestrict     String?
  booking            booking[]
  marketing_campaign marketing_campaign? @relation(fields: [campaignId], references: [id])
}

model recently_viewed {
  id                String          @id @default(cuid())
  vendorId          String
  serviceId         String?
  timestamp         DateTime        @default(now())
  customerProfileId String
  customerprofile   customerprofile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  vendor            vendorprofile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
  @@index([timestamp])
}

model saved_search {
  id                String          @id @default(cuid())
  name              String?
  filters           Json
  query             String?
  createdAt         DateTime        @default(now())
  customerProfileId String
  customerprofile   customerprofile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
}

model referral {
  id           String          @id @default(cuid())
  referrerId   String
  referredId   String          @unique
  code         String
  status       String          @default("PENDING")
  rewardPoints Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  referred     customerprofile @relation("Referred", fields: [referredId], references: [id])
  referrer     customerprofile @relation("Referrer", fields: [referrerId], references: [id])
}

model loyalty_transaction {
  id                String          @id @default(cuid())
  points            Int
  type              String
  reason            String
  referenceId       String?
  createdAt         DateTime        @default(now())
  customerProfileId String
  customerprofile   customerprofile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
}

model dispute {
  id          String         @id @default(cuid())
  bookingId   String         @unique(map: "Dispute_bookingId_key")
  raisedBy    String
  reason      String
  description String
  evidence    Json?
  status      dispute_status @default(OPEN)
  resolution  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime
  booking     booking        @relation(fields: [bookingId], references: [id], map: "Dispute_bookingId_fkey")
}

model eventcheckin {
  id          String    @id @default(cuid())
  bookingId   String    @unique(map: "EventCheckin_bookingId_key")
  otp         String
  generatedAt DateTime  @default(now())
  verifiedAt  DateTime?
  status      String    @default("PENDING")
  booking     booking   @relation(fields: [bookingId], references: [id], map: "EventCheckin_bookingId_fkey")
}

model globalsettings {
  id          String  @id @default(cuid())
  key         String  @unique(map: "GlobalSettings_key_key")
  value       String
  description String?
}

model commission_rule {
  id        String    @id @default(cuid())
  name      String
  type      String
  targetId  String?
  rate      Decimal   @db.Decimal(5, 2)
  priority  Int       @default(0)
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type, targetId])
}

model tax_config {
  id          String   @id @default(cuid())
  hsnCode     String   @unique
  description String?
  gstRate     Decimal  @db.Decimal(5, 2)
  cgstRate    Decimal  @db.Decimal(5, 2)
  sgstRate    Decimal  @db.Decimal(5, 2)
  igstRate    Decimal  @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model settlement {
  id                String        @id @default(cuid())
  vendorId          String
  payoutId          String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  taxDeducted       Decimal       @default(0.00) @db.Decimal(10, 2)
  commissionCharged Decimal       @db.Decimal(10, 2)
  netAmount         Decimal       @db.Decimal(10, 2)
  status            String        @default("PENDING")
  periodStart       DateTime
  periodEnd         DateTime
  reference         String?       @unique
  bankDetails       Json?
  auditLog          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  payout            payout?       @relation(fields: [payoutId], references: [id])
  vendor            vendorprofile @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([status])
}

model fraud_detection_log {
  id          String         @id @default(cuid())
  userId      String?
  vendorId    String?
  type        String
  severity    String         @default("LOW")
  description String
  evidence    Json?
  status      String         @default("OPEN")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        user?          @relation(fields: [userId], references: [id])
  vendor      vendorprofile? @relation(fields: [vendorId], references: [id])

  @@index([type])
  @@index([severity])
}

model invoice {
  id            String   @id @default(cuid())
  bookingId     String   @unique(map: "Invoice_bookingId_key")
  invoiceNumber String   @unique(map: "Invoice_invoiceNumber_key")
  pdfUrl        String?
  createdAt     DateTime @default(now())
  gstDetails    Json?
  subTotal      Decimal  @default(0.00) @db.Decimal(10, 2)
  taxAmount     Decimal  @default(0.00) @db.Decimal(10, 2)
  totalAmount   Decimal  @default(0.00) @db.Decimal(10, 2)
  type          String   @default("BOOKING")
  booking       booking  @relation(fields: [bookingId], references: [id], map: "Invoice_bookingId_fkey")
}

model locationtrackinglog {
  id        String   @id @default(cuid())
  userId    String
  latitude  Float
  longitude Float
  accuracy  Float?
  source    String?
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], map: "LocationTrackingLog_userId_fkey")

  @@index([userId], map: "LocationTrackingLog_userId_idx")
}

model message {
  id                String              @id @default(cuid())
  conversationId    String
  senderId          String
  content           String
  isRead            Boolean             @default(false)
  createdAt         DateTime            @default(now())
  bookingId         String?
  booking           booking?            @relation(fields: [bookingId], references: [id], map: "Message_bookingId_fkey")
  conversation      conversation        @relation(fields: [conversationId], references: [id], map: "Message_conversationId_fkey")
  user              user                @relation(fields: [senderId], references: [id], map: "Message_senderId_fkey")
  messageattachment messageattachment[]

  @@index([bookingId], map: "Message_bookingId_idx")
  @@index([conversationId], map: "Message_conversationId_idx")
  @@index([senderId], map: "Message_senderId_idx")
}

model messageattachment {
  id        String   @id @default(cuid())
  messageId String
  url       String
  type      String
  createdAt DateTime @default(now())
  message   message  @relation(fields: [messageId], references: [id], map: "MessageAttachment_messageId_fkey")

  @@index([messageId], map: "MessageAttachment_messageId_idx")
}

model notification {
  id        String                @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean               @default(false)
  link      String?
  createdAt DateTime              @default(now())
  category  notification_category @default(SYSTEM)
  emailSent Boolean               @default(false)
  metadata  Json?
  priority  notification_priority @default(MEDIUM)
  pushSent  Boolean               @default(false)
  smsSent   Boolean               @default(false)
  user      user                  @relation(fields: [userId], references: [id], map: "Notification_userId_fkey")

  @@index([userId, isRead, createdAt])
  @@index([userId], map: "Notification_userId_idx")
  @@index([category])
  @@index([isRead])
  @@index([createdAt])
}

model notification_preference {
  id       String                @id @default(cuid())
  userId   String                @unique
  category notification_category
  email    Boolean               @default(true)
  sms      Boolean               @default(false)
  push     Boolean               @default(true)
  user     user                  @relation(fields: [userId], references: [id], map: "NotificationPreference_userId_fkey")

  @@unique([userId, category])
}

/// This model has been renamed to 'Renamedpackage' during introspection, because the original name 'package' is reserved.
model Renamedpackage {
  id            String          @id @default(cuid())
  serviceId     String
  name          String
  description   String?
  price         Decimal         @db.Decimal(10, 2)
  inclusions    Json?
  exclusions    Json?
  images        Json?
  videos        Json?
  bookingitem   bookingitem[]
  service       service         @relation(fields: [serviceId], references: [id], map: "Package_serviceId_fkey")
  package_addon package_addon[]
  pricingrule   pricingrule[]

  @@index([serviceId], map: "Package_serviceId_idx")
  @@index([price])
  @@map("package")
}

model payment {
  id                  String                @id @default(cuid())
  bookingId           String
  amount              Decimal               @db.Decimal(10, 2)
  currency            String                @default("INR")
  status              payment_status        @default(PENDING)
  razorpayOrderId     String?               @unique(map: "Payment_razorpayOrderId_key")
  razorpayPaymentId   String?               @unique(map: "Payment_razorpayPaymentId_key")
  razorpaySignature   String?
  method              String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  paymentType         String?               @default("FULL")
  orderId             String?
  booking             booking               @relation(fields: [bookingId], references: [id], map: "Payment_bookingId_fkey")
  order               order?                @relation(fields: [orderId], references: [id])
  payment_split       payment_split?
  payment_transaction payment_transaction[]

  @@index([bookingId, status, createdAt])
  @@index([bookingId], map: "Payment_bookingId_idx")
}

model payment_transaction {
  id                    String   @id @default(cuid())
  paymentId             String
  externalTransactionId String?  @unique
  status                String   @default("PENDING")
  method                String?
  amount                Decimal  @db.Decimal(10, 2)
  currency              String   @default("INR")
  metadata              Json?
  errorDetails          Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  payment               payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([externalTransactionId])
}

model payment_split {
  id                String          @id @default(cuid())
  paymentId         String          @unique
  bookingId         String
  vendorId          String
  totalAmount       Decimal         @db.Decimal(10, 2)
  adminShare        Decimal         @db.Decimal(10, 2)
  vendorShare       Decimal         @db.Decimal(10, 2)
  commissionRate    Decimal         @db.Decimal(5, 2)
  status            String          @default("PENDING")
  transactionId     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  customerProfileId String
  booking           booking         @relation(fields: [bookingId], references: [id])
  customer          customerprofile @relation(fields: [customerProfileId], references: [id])
  payment           payment         @relation(fields: [paymentId], references: [id])
  vendor            vendorprofile   @relation(fields: [vendorId], references: [id])

  @@index([paymentId])
  @@index([bookingId])
  @@index([vendorId])
  @@index([customerProfileId])
}

model payout {
  id            String        @id @default(cuid())
  vendorId      String
  amount        Decimal       @db.Decimal(10, 2)
  status        payout_status @default(PENDING)
  reference     String?       @unique(map: "Payout_reference_key")
  bankDetails   Json?
  notes         String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  vendorprofile vendorprofile @relation(fields: [vendorId], references: [id], map: "Payout_vendorId_fkey")
  settlement    settlement?

  @@index([vendorId], map: "Payout_vendorId_idx")
}

model portfolio {
  id              String        @id @default(cuid())
  vendorProfileId String
  serviceId       String?
  mediaUrl        String
  mediaType       String
  title           String?
  description     String?
  service         service?      @relation(fields: [serviceId], references: [id], map: "Portfolio_serviceId_fkey")
  vendorprofile   vendorprofile @relation(fields: [vendorProfileId], references: [id], map: "Portfolio_vendorProfileId_fkey")

  @@index([serviceId], map: "Portfolio_serviceId_idx")
  @@index([vendorProfileId], map: "Portfolio_vendorProfileId_idx")
}

model pricingrule {
  id             String         @id @default(cuid())
  packageId      String
  minGuests      Int
  maxGuests      Int
  pricePerGuest  Decimal        @db.Decimal(10, 2)
  flatFee        Decimal        @default(0.00) @db.Decimal(10, 2)
  Renamedpackage Renamedpackage @relation(fields: [packageId], references: [id], map: "PricingRule_packageId_fkey")

  @@index([packageId], map: "PricingRule_packageId_idx")
}

model refreshtoken {
  id         String    @id @default(cuid())
  userId     String
  expiryDate DateTime
  createdAt  DateTime  @default(now())
  browser    String?
  deviceName String?
  ipAddress  String?
  lastUsedAt DateTime  @default(now())
  os         String?
  replacedBy String?
  revokedAt  DateTime?
  tokenHash  String    @unique(map: "RefreshToken_tokenHash_key") @db.VarChar(255)
  userAgent  String?
  user       user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "RefreshToken_userId_fkey")

  @@index([userId], map: "RefreshToken_userId_idx")
  @@index([expiryDate])
  @@index([tokenHash])
}

model refund {
  id          String        @id @default(cuid())
  bookingId   String        @unique(map: "Refund_bookingId_key")
  amount      Decimal       @db.Decimal(10, 2)
  reason      String?
  status      refund_status @default(REQUESTED)
  processedAt DateTime?
  createdAt   DateTime      @default(now())
