  id                String        @id @default(cuid())
  vendorProfileId   String        @unique(map: "VendorScore_vendorProfileId_key")
  ratingScore       Float         @default(0)
  reviewScore       Float         @default(0)
  distanceScore     Float         @default(0)
  availabilityScore Float         @default(0)
  completionScore   Float         @default(0)
  finalScore        Float         @default(0)
  updatedAt         DateTime
  vendorprofile     vendorprofile @relation(fields: [vendorProfileId], references: [id], map: "VendorScore_vendorProfileId_fkey")
}

model wallet {
  id               String        @id @default(cuid())
  userId           String?       @unique(map: "Wallet_userId_key")
  balance          Decimal       @default(0.00) @db.Decimal(10, 2)
  pendingBalance   Decimal       @default(0.00) @db.Decimal(10, 2)
  withdrawable     Decimal       @default(0.00) @db.Decimal(10, 2)
  lifetimeEarnings Decimal       @default(0.00) @db.Decimal(10, 2)
  lifetimeSpending Decimal       @default(0.00) @db.Decimal(10, 2)
  type             wallet_type   @default(USER)
  transaction      transaction[]
  user             user?         @relation(fields: [userId], references: [id], map: "Wallet_userId_fkey")
}

model webhookevent {
  id        String   @id @default(cuid())
  eventId   String   @unique(map: "WebhookEvent_eventId_key")
  source    String
  type      String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model wishlist {
  id                String          @id @default(cuid())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  customerProfileId String          @unique(map: "Wishlist_customerProfileId_key")
  customerprofile   customerprofile @relation(fields: [customerProfileId], references: [id], map: "Wishlist_customerProfileId_fkey")
  wishlistitem      wishlistitem[]
}

model wishlistitem {
  id         String   @id @default(cuid())
  wishlistId String
  type       String
  targetId   String
  createdAt  DateTime @default(now())
  wishlist   wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade, map: "WishlistItem_wishlistId_fkey")

  @@unique([wishlistId, targetId, type], map: "WishlistItem_wishlistId_targetId_type_key")
}

model order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  customerProfileId String
  status            order_status    @default(DRAFT)
  idempotencyKey    String?         @unique
  packageAmount     Decimal         @default(0.00) @db.Decimal(10, 2)
  addonAmount       Decimal         @default(0.00) @db.Decimal(10, 2)
  discountAmount    Decimal         @default(0.00) @db.Decimal(10, 2)
  gstAmount         Decimal         @default(0.00) @db.Decimal(10, 2)
  platformFee       Decimal         @default(0.00) @db.Decimal(10, 2)
  totalAmount       Decimal         @default(0.00) @db.Decimal(10, 2)
  advanceAmount     Decimal         @default(0.00) @db.Decimal(10, 2)
  balanceAmount     Decimal         @default(0.00) @db.Decimal(10, 2)
  couponId          String?
  financialSnapshot Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  bookings          booking[]
  customer          customerprofile @relation(fields: [customerProfileId], references: [id])
  order_item        order_item[]
  payments          payment[]
  reservations      reservation[]

  @@index([customerProfileId])
  @@index([status])
  @@index([createdAt])
}

model order_item {
  id             String   @id @default(cuid())
  orderId        String
  vendorId       String
  serviceId      String
  packageId      String
  quantity       Int      @default(1)
  eventDate      DateTime
  eventTime      String?
  guestCount     Int
  location       String
  notes          String?
  addons         Json?
  packageAmount  Decimal  @db.Decimal(10, 2)
  addonAmount    Decimal  @default(0.00) @db.Decimal(10, 2)
  discountAmount Decimal  @default(0.00) @db.Decimal(10, 2)
  gstAmount      Decimal  @default(0.00) @db.Decimal(10, 2)
  platformFee    Decimal  @default(0.00) @db.Decimal(10, 2)
  totalAmount    Decimal  @db.Decimal(10, 2)
  priceSnapshot  Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([vendorId])
}

model reservation {
  id        String             @id @default(cuid())
  vendorId  String
  eventDate DateTime
  orderId   String?
  expiresAt DateTime
  status    reservation_status @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  order     order?             @relation(fields: [orderId], references: [id])
  vendor    vendorprofile      @relation(fields: [vendorId], references: [id])

  @@index([vendorId, eventDate])
  @@index([expiresAt])
  @@index([status])
}

model passwordresettoken {
  id        String   @id @default(cuid())
  token     String   @unique(map: "PasswordResetToken_token_key")
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId], map: "PasswordResetToken_userId_idx")
}

model subscriptionpayment {
  id                 String                     @id @default(cuid())
  subscriptionId     String
  amount             Decimal                    @db.Decimal(10, 2)
  currency           String                     @default("INR")
  razorpayOrderId    String                     @unique(map: "SubscriptionPayment_razorpayOrderId_key")
  razorpayPaymentId  String?                    @unique(map: "SubscriptionPayment_razorpayPaymentId_key")
  razorpaySignature  String?
  status             subscriptionpayment_status @default(PENDING)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime
  vendorsubscription vendorsubscription         @relation(fields: [subscriptionId], references: [id], map: "SubscriptionPayment_subscriptionId_fkey")

  @@index([subscriptionId], map: "SubscriptionPayment_subscriptionId_idx")
}

model subscriptionplan {
  id                 String               @id @default(cuid())
  name               String               @unique(map: "SubscriptionPlan_name_key")
  price              Decimal              @db.Decimal(10, 2)
  durationMonths     Int                  @default(1)
  listingLimit       Int                  @default(3)
  features           Json
  rank               Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  vendorsubscription vendorsubscription[]
}

model vendorsubscription {
  id                  String                    @id @default(cuid())
  vendorProfileId     String                    @unique(map: "VendorSubscription_vendorProfileId_key")
  planId              String
  startDate           DateTime                  @default(now())
  endDate             DateTime
  status              vendorsubscription_status @default(ACTIVE)
  autoRenew           Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime
  subscriptionpayment subscriptionpayment[]
  subscriptionplan    subscriptionplan          @relation(fields: [planId], references: [id], map: "VendorSubscription_planId_fkey")
  vendorprofile       vendorprofile             @relation(fields: [vendorProfileId], references: [id], map: "VendorSubscription_vendorProfileId_fkey")

  @@index([planId], map: "VendorSubscription_planId_idx")
}

model reportschedule {
  id              String        @id @default(cuid())
  vendorProfileId String        @unique
  frequency       String        @default("MONTHLY")
  format          String        @default("PDF")
  recipientEmail  String?
  reportTypes     Json
  isActive        Boolean       @default(true)
  lastRun         DateTime?
  nextRun         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  vendorprofile   vendorprofile @relation(fields: [vendorProfileId], references: [id])

  @@index([vendorProfileId])
  @@index([nextRun])
}

model expense {
  id              String        @id @default(cuid())
  vendorProfileId String
  title           String
  amount          Decimal       @db.Decimal(10, 2)
  category        String
  date            DateTime      @default(now())
  status          String        @default("PAID")
  reference       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  vendorprofile   vendorprofile @relation(fields: [vendorProfileId], references: [id])

  @@index([vendorProfileId])
  @@index([category])
  @@index([date])
}

model booking_timeline {
  id          String   @id @default(cuid())
  bookingId   String
  title       String
  description String?
  performedBy String?
  role        String?
  metadata    Json?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  booking     booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model vendor_team {
  id              String               @id @default(cuid())
  vendorProfileId String
  name            String
  description     String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  vendorprofile   vendorprofile        @relation(fields: [vendorProfileId], references: [id])
  members         vendor_team_member[]

  @@index([vendorProfileId])
}

model vendor_team_member {
  id          String                    @id @default(cuid())
  teamId      String
  userId      String?
  name        String
  role        String
  email       String?
  phone       String?
  avatar      String?
  status      String                    @default("Active")
