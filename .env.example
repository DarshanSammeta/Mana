# ====================================================
# MANA EVENTS – PRODUCTION ENVIRONMENT TEMPLATE
# ====================================================

# --- [REQUIRED] Core Infrastructure ---
NODE_ENV=production
# The public URL of the application (e.g., https://manaevents.in)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Internal API URL used for server-side fetches
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Secret for protecting NextAuth.js sessions and cookies
NEXTAUTH_SECRET=generate_a_secret_here_32_chars
# Secret for verifying Cron jobs (provided in X-Cron-Secret header)
CRON_SECRET=mana_cron_secret_7d2f8e1a9c3b
# Versioning for logs and health checks
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_GIT_COMMIT=unknown

# --- [REQUIRED] Database (PostgreSQL) ---
# Primary connection string (usually pointing to a pooler like PgBouncer)
DATABASE_URL="postgresql://user:pass@host:6543/db?pgbouncer=true"
# Direct connection string (for migrations only, bypasses pooler)
DIRECT_URL="postgresql://user:pass@host:5432/db"

# --- [REQUIRED] Redis (BullMQ & Caching) ---
# Primary Redis URI for ioredis (BullMQ and distributed locks)
REDIS_URL="redis://localhost:6379"
# Upstash REST URL (used by @upstash/redis in edge/middleware)
UPSTASH_REDIS_REST_URL=https://...
# Upstash REST Token
UPSTASH_REDIS_REST_TOKEN=...

# --- [REQUIRED] Authentication (JWT) ---
# Secret for signing access tokens (e.g., 15m expiry)
JWT_ACCESS_SECRET=your-access-secret-key-64-chars
# Secret for signing refresh tokens (e.g., 7d expiry)
JWT_REFRESH_SECRET=your-refresh-secret-key-64-chars

# --- [REQUIRED] Search (Meilisearch) ---
# Meilisearch host URL
MEILISEARCH_HOST=http://localhost:7700
# Meilisearch Master Key
MEILISEARCH_API_KEY=masterKey
# The index name for vendor profiles
MEILISEARCH_VENDORS_INDEX=vendors

# --- [REQUIRED] Payments (Razorpay) ---
# Public Key ID for the frontend SDK
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
# Secret Key for backend API calls
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Secret for verifying webhook signatures
RAZORPAY_WEBHOOK_SECRET=...

# --- [REQUIRED] Emails (Resend) ---
# API Key for Resend email delivery
RESEND_API_KEY=re_...
# Default sender for system alerts
ADMIN_EMAIL=admin@manaevents.com

# --- [REQUIRED] Storage (Cloudinary) ---
# Cloudinary Cloud Name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=...
# API Key
CLOUDINARY_API_KEY=...
# API Secret
CLOUDINARY_API_SECRET=...
# full URL (Optional if individual keys provided)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- [REQUIRED] Background Jobs (Inngest) ---
# Event Key for sending events to Inngest
INNGEST_EVENT_KEY=local
# Signing Key for securing Inngest webhooks
INNGEST_SIGNING_KEY=local

# --- [REQUIRED] Maps (Google Maps) ---
# API Key for Google Maps and Places
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...

# --- [OPTIONAL] SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- [OPTIONAL] Notifications (Firebase FCM) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- [OPTIONAL] Socket.io ---
# URL for the WebSocket server (if different from NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# --- [OPTIONAL] Observability ---
# Minimum level for Winston logger (info, warn, error, debug)
LOG_LEVEL=info
# Set to "true" to skip rate limiting (only for local dev/CI)
DISABLE_RATE_LIMITING=false
# Webhook URL for Slack alerts
SLACK_WEBHOOK_URL=
# OpenTelemetry Exporter Endpoints
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
